# ==========================================
# Root .gitignore for Splunk Demo Project
# (.NET Web API + Angular UI + Splunk Docker)
# ==========================================

# ------------------------------------------
# .NET / C# Build & Compiler Artifacts
# ------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
!**/logs/
!**/logs/.gitkeep
**/logs/*.json
**/logs/*.log
*.log

# Visual Studio / Rider / Omnisharp
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# ------------------------------------------
# SQLite Local Databases & Runtime Files
# ------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ------------------------------------------
# Node / Angular Frontend Artifacts
# ------------------------------------------
**/node_modules/
**/dist/
**/.angular/
.angular/cache/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# Splunk Container Runtime Data
# ------------------------------------------
splunk/splunk_data/
*.pid
*.lock

# ------------------------------------------
# IDE & Editor Configuration
# ------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# OS & Environment Files
# ------------------------------------------
.DS_Store
Thumbs.db
*.tmp
*.temp
.env
.env.local
